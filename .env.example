# Exemplo para processos Node executados no host. Nunca use os placeholders como senhas.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://rh_app:SUBSTITUA@127.0.0.1:55433/rh
# Somente scripts de migração/provisionamento precisam desta credencial administrativa.
DATABASE_ADMIN_URL=postgresql://postgres:SUBSTITUA@127.0.0.1:55433/rh
AUDIT_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
OIDC_ISSUER=http://localhost:8080/realms/rh
OIDC_CLIENT_ID=rh-web
OIDC_CLIENT_SECRET=SUBSTITUA
KEYCLOAK_ADMIN_CLIENT_ID=rh-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=SUBSTITUA
INITIAL_ADMIN_EMAIL=admin@example.test
ORGANIZATION_NAME=Equipe de RH
RETENTION_APPROVED=false
INITIAL_ADMIN_PASSWORD=123
# Produção exige HTTPS, política aprovada e prazos definidos pelo controlador.
# RETENTION_DAYS=...
# AUDIT_RETENTION_DAYS=...

{
  "name": "rh-colaborativo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "dev:web": "vite --host 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx src/server/worker-main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/server/worker-main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/migrate.ts",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx src/server/bootstrap.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "configure": "tsx scripts/configure.ts",
    "mvp:up": "pnpm configure && docker compose --env-file .local/dev.env up -d --build",
    "mvp:down": "docker compose --env-file .local/dev.env down",
    "mvp:status": "docker compose --env-file .local/dev.env ps",
    "test:integration": "node --env-file=.local/test.env node_modules/vitest/vitest.mjs run tests/integration.test.ts",
    "test:e2e:docker": "docker compose --env-file .local/dev.env run --rm e2e",
    "backup": "tsx scripts/recovery.ts backup",
    "recovery:rehearse": "tsx scripts/recovery.ts rehearse"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-data-grid": "^7.0.0-beta.59",
    "fastify": "^5.6.0",
    "zod": "^4.1.0",
    "pg": "^8.16.0",
    "kysely": "^0.28.0",
    "openid-client": "^6.8.0",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0"
  }
}
